# =======================================
# الرباطاب - منصة رابطة أبناء أبوحمد
# Environment Configuration
# =======================================

# =======================================
# SERVER CONFIGURATION
# =======================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000
API_PREFIX=/api/v1

# =======================================
# DATABASE CONFIGURATION
# =======================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/al_raba7ab
DB_HOST=localhost
DB_PORT=5432
DB_NAME=al_raba7ab
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# =======================================
# JWT CONFIGURATION
# =======================================
JWT_SECRET=your_super_secret_jwt_key_here_must_be_min_32_chars_long_for_security
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_must_be_min_32_chars_long
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d
JWT_ALGORITHM=HS256

# =======================================
# SECURITY CONFIGURATION
# =======================================
BCRYPT_ROUNDS=12
ARGON2_TIME=3
ARGON2_MEMORY=65536
ARGON2_PARALLELISM=4

MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=30

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# =======================================
# EMAIL CONFIGURATION
# =======================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@alraba7ab.com
EMAIL_FROM_NAME=الرباطاب

# =======================================
# FILE UPLOAD CONFIGURATION
# =======================================
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png,gif,webp,mp4,avi,mkv,mov,wav,mp3
UPLOAD_PATH=./uploads
UPLOAD_DIR_TIMEOUT_HOURS=24

# =======================================
# ENCRYPTION CONFIGURATION
# =======================================
ENCRYPTION_KEY=your_encryption_key_here_must_be_32_chars_long_for_aes_256
ENCRYPTION_ALGORITHM=aes-256-cbc
ENCRYPTION_IV=your_initialization_vector_16_chars

# =======================================
# REDIS CONFIGURATION (Optional)
# =======================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# =======================================
# SOCKET.IO CONFIGURATION
# =======================================
SOCKET_ENABLED=true
SOCKET_CORS_ORIGIN=http://localhost:3000
SOCKET_CORS_CREDENTIALS=true
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=60000

# =======================================
# FRONTEND CONFIGURATION
# =======================================
VITE_API_URL=http://localhost:5000/api/v1
VITE_API_TIMEOUT=30000
VITE_SOCKET_URL=http://localhost:5000

# =======================================
# LOGGING CONFIGURATION
# =======================================
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_FORMAT=json

# =======================================
# MFA CONFIGURATION
# =======================================
MFA_ENABLED=true
TOTP_WINDOW=2
MFA_EMAIL_TIMEOUT_MINUTES=15
MFA_SMS_TIMEOUT_MINUTES=10
MFA_RECOVERY_CODES_COUNT=10

# =======================================
# BACKUP CONFIGURATION
# =======================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups
BACKUP_ENCRYPT=true

# =======================================
# FEATURE FLAGS
# =======================================
FEATURE_SOCIAL_ENABLED=true
FEATURE_ACADEMIC_ENABLED=true
FEATURE_FINANCIAL_ENABLED=true
FEATURE_MEDIA_ENABLED=true
FEATURE_EVENTS_ENABLED=true
FEATURE_MFA_ENABLED=true
FEATURE_API_DOCS_ENABLED=true

# =======================================
# DEBUG CONFIGURATION
# =======================================
DEBUG=false
VERBOSE_LOGGING=false
DEBUG_REQUESTS=false
DEBUG_DATABASE=false
