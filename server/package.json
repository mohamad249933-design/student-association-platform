{
  "name": "al-raba7ab-server",
  "version": "1.0.0",
  "description": "Backend server for Al-Raba7ab Student Association Platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:migrate": "node --loader ts-node/esm src/database/migrations.ts",
    "db:seed": "node --loader ts-node/esm src/database/seeders.ts",
    "db:reset": "npm run db:migrate && npm run db:seed"
  },
  "keywords": [
    "al-raba7ab",
    "backend",
    "api",
    "student-association"
  ],
  "author": "Al-Raba7ab Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "typescript": "^5.3.2",
    "pg": "^8.11.3",
    "sequelize": "^6.35.2",
    "redis": "^4.6.12",
    "socket.io": "^4.7.2",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "argon2": "^0.31.2",
    "crypto-js": "^4.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "uuid": "^9.0.1",
    "nodemailer": "^6.9.7",
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.11",
    "@types/nodemailer": "^6.4.14",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "ts-node": "^10.9.2",
    "vitest": "^1.1.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12"
  }
}
