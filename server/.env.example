# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/al_raba7ab
DB_HOST=localhost
DB_PORT=5432
DB_NAME=al_raba7ab
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_must_be_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_must_be_min_32_chars
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Security
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=your_encryption_key_must_be_32_chars_long

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@alraba7ab.com

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# CORS
CORS_ORIGIN=http://localhost:3000
